{
  "schemaVersion": 1,
  "id": "betterthanambiance",
  "version": "${version}",

  "name": "Better Than Ambiance",
  "description": "An ambiance mod that improves the rain experience!",
  "authors": [
    "Pasithea0"
  ],
  "contact": {
    "homepage": "https://github.com/Pasithea0/better-than-rain",
    "sources": "https://github.com/Pasithea0/better-than-rain"
  },

	"icon": "icon.png",
  "license": "MIT",

  "environment": "*",
  "entrypoints": {
    "main": [
			"com.pasithea0.betterthanambiance.BetterThanAmbianceMod"
    ],
		"beforeGameStart": [
			"com.pasithea0.betterthanambiance.BetterThanAmbianceMod"
		],
		"afterGameStart": [
			"com.pasithea0.betterthanambiance.BetterThanAmbianceMod"
		],
		"recipesReady": [
			"com.pasithea0.betterthanambiance.BetterThanAmbianceMod"
		],
		"beforeClientStart": [
			"com.pasithea0.betterthanambiance.BetterThanAmbianceMod"
		],
		"afterClientStart": [
			"com.pasithea0.betterthanambiance.BetterThanAmbianceMod",
			"com.pasithea0.betterthanambiance.gui.GuiOptionsPageBetterThanAmbiance"
		],
		"initOptions": [
			"com.pasithea0.betterthanambiance.BetterThanAmbianceMod"
		]
	},
  "mixins": [
      "betterthanambiance.mixins.json"
  ],

  "depends": {
		"fabricloader": ">=${fabricloader}",
		"minecraft": "*",
		"java": ">=${java}"
  },
  "suggests": {
		"modmenu": ">=${modmenu}"
  }
}
